# EVIDIQ Cadence MCP — environment template.
# Copy to .env (or the VPS env file) and fill in. Never commit real values.

# --- server ---
PORT=3018
HOSTNAME=0.0.0.0
PUBLIC_BASE_URL=https://mcp.evidiq.dev/cadence

# --- signer (no fallback; unset -> signing tools refuse) ---
# Bare 64-hex or 0x-prefixed 32-byte private key. Derives the fleet signer.
CADENCE_SIGNER_PRIVATE_KEY=

# --- store ---
CADENCE_DB_PATH=/data/cadence.db

# --- x402 ---
# Phase 1: 1 bypasses the gate (paid tools answer 200). Phase 2: remove.
X402_BYPASS=1
X402_PAY_TO=
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- 0G Storage anchoring (best effort — attest_execution) ---
# Failures never fail the paid result; anchoring.status reports the real upload outcome.
OG_PRIVATE_KEY=
OG_STORAGE_RPC=https://evmrpc.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
OG_CHAIN_ID=16661
OG_COMPUTE_RPC=https://evmrpc.0g.ai

# --- node ---
NODE_ENV=production
